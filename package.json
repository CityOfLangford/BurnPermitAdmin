{
  "name": "permit-admin-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm --workspace packages/api run dev\" \"npm --workspace packages/app run dev\"",
    "api": "npm --workspace packages/api run dev",
    "app": "npm --workspace packages/app run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
