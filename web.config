<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Proxy API requests" stopProcessing="true">
          <match url="^api(?:/.*)?$" />
          <action type="Rewrite" url="http://localhost:3001/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="Proxy app requests" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="http://localhost:50111/{R:0}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
